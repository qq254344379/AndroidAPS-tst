<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Colours the carried-over layouts and icons still reference. In the 4.4.2.6 xindana
         build these lived in the (since removed) pump/embecta and pump/diaconn modules plus
         core/ui; values copied from the decoded APK. -->
    <color name="pumpStatusBackground">#cccccc</color>
    <color name="userOption">#66bb6a</color>
    <color name="ic_actions_refill">#e93057</color>

    <!-- Backing colours for the GrayButton style below. Upstream used the shared
         @color/ctrl_btn_bg_color_selector_grey, which no longer exists anywhere, so the
         module defines its own selector instead of dragging in a dead reference. -->
    <color name="lenomed_gray_button_normal">#9e9e9e</color>
    <color name="lenomed_gray_button_pressed">#757575</color>

    <!-- The history/stats icons were drawn with `?pumpHistoryColor` / `?statsColor`, theme
         attributes that no longer exist (dev replaced these two icons with Compose versions,
         see core/ui/.../compose/icons/IcHistory.kt). They are drawn as `android:drawableTop` on
         the gray buttons above, so a light neutral reads correctly on that background. -->
    <color name="lenomed_button_icon">#f0f0f0</color>
</resources>
